# Copy to .env for local dev (Expo inlines EXPO_PUBLIC_* at bundle time).
# For EAS builds, set these under build.<profile>.env in eas.json or as EAS secrets.

# Bluelime backend (Next.js on Vercel). Defaults to https://bluelime.ai if unset.
EXPO_PUBLIC_API_BASE=https://bluelime.ai

# The SAME Supabase project buyers sign up against on the web (one shared account).
# Anon/public key is safe to embed in a client build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
